APP_NAME="Tuition Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true  # MUST be false in production
APP_TIMEZONE=Asia/Colombo
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuition_management
DB_USERNAME=root
DB_PASSWORD=

# RFID Gate API Key (CHANGE IN PRODUCTION - minimum 32 characters)
GATE_API_KEY=dev-gate-api-key-change-in-production

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null  # Set to .yourdomain.com in production
SESSION_SECURE_COOKIE=false  # Set to true in production (HTTPS only)
SESSION_SAME_SITE=lax  # Set to strict in production

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_TOKEN_EXPIRATION=1440  # Token expiration in minutes (24 hours)

# CORS Configuration (Production - Set specific origins)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sentry Error Monitoring
SENTRY_LARAVEL_DSN=
# Get your DSN from https://sentry.io/settings/your-org/projects/your-project/keys/
# Example: SENTRY_LARAVEL_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.2  # 20% of requests for performance monitoring
SENTRY_PROFILES_SAMPLE_RATE=0.2  # 20% for profiling
